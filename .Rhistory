dose <- ev(amt = 0, cmt = 1, II = maintenance_dose_ii,
ADDL = maintenance_dose_addl, time = 0)
multiple_dose_data <- ev_rep(dose, ID = id_count) %>% rename(EVID= evid, TIME=time,
CMT=cmt, AMT = amt)
Sim_data <- pop$WHO_data_HT_WT_FFM %>%
merge(multiple_dose_data, by = "ID", all.x = TRUE)
NM_Allo <- Sim_data %>%
mutate(
FLOORED_HT = ((HT %/% 10) *10),
FLOORED_WT = floor(WT),
FFM_2005 = ifelse(SEX == 0,
((9.27e3 * FLOORED_WT) / (6.68e3 + 216 * (FLOORED_WT / ((FLOORED_HT / 100) ^ 2)))),
((9.27e3 * FLOORED_WT) / (8.78e3 + 244 * (FLOORED_WT / ((FLOORED_HT / 100) ^ 2)))))
) %>%
mutate(
AMT = ifelse(EVID == 1, case_when(
WT >= 45 ~ 150,
WT >= 30 & WT < 45 ~ 100,
WT < 30 ~ plyr::round_any(150 * (FFM_2005 / 53) ^ 0.75, 10)
), 0),
SEX = as.numeric(SEX)) %>%
mutate(AMT = ifelse(AMT == 90, 100, AMT)) %>%
dplyr::select(ID, TIME, EVID, CMT, II, ADDL, AMT, AGE, SEX, HT, WT, FFM) %>%
arrange(ID, TIME)
set.seed(9119)
allometric_ffm_model <- model %>%
data_set(NM_Allo) %>%
carry.out(a.u.g) %>%
obsaug %>%
param(TSWITCH= (treatment_duration + 0)*24)%>%
mrgsim(delta = 24, end = 70 * 24)%>%
as.data.frame()
allo_FFM_pk_stat <- pk_summary(allometric_ffm_model, treatment_duration)
allometric_ffm <- allometric_ffm_model %>% group_by(ID) %>%
mutate( AMT = max(AMT))
Allometric_FFM <- create_bin(allometric_ffm, Time = treatment_duration,200,"mode")
upper_ci_obs_AUC <- round(quantile(Allometric_FFM$AUC, 0.95), 0)
lower_ci_obs_TOEC90 <- round(quantile(Allometric_FFM$TEC90, 0.05), 0)
AUC_TOEC90_Allometric_FFM <- AUC_TOEC90_summary(Allometric_FFM, upper_ci_obs_AUC, lower_ci_obs_TOEC90)
lower_ci_obs_TOEC90 <- round(quantile(Allometric_FFM$T_EC90, 0.05), 0)
round(quantile(Allometric_FFM$T_EC90, 0.05), 0
)
round(quantile(Allometric_FFM$T_EC90, 0.05), 0)
ggplot(Allometric_FFM, aes(x = T_EC90)) + geom_density(fill = "lightblue", alpha = 0.5) +
geom_vline(xintercept = 3, color = "black", linetype = "dashed") +
labs(title = "TEC90 distribution", x = "T to EC90 (Days)", y = "Density") + theme_classic()
round(quantile(Allometric_FFM$T_EC90, 0.95), 0)
ggplot(Allometric_FFM, aes(x = T_EC90)) + geom_density(fill = "lightblue", alpha = 0.5) +
geom_vline(xintercept = 9.5, color = "black", linetype = "dashed") +
labs(title = "TEC90 distribution", x = "T to EC90 (Days)", y = "Density") + theme_classic()
runApp()
