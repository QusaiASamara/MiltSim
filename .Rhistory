create_comparison_plots <- function(original, bootstrap) {
plot_list <- list()
# AGE distribution
p1 <- ggplot() +
geom_density(data = original, aes(x = AGE, fill = "Original"), alpha = 0.2) +
geom_density(data = bootstrap, aes(x = AGE, fill = "Cleaned"), alpha = 0.2) +
scale_fill_manual(values = c("Original" = "blue", "Cleaned" = "red")) +
labs(title = "Age Distribution Comparison", x = "Age", y = "Density") +
theme_bw() +
theme(legend.position = "top",panel.grid.major = element_blank(),
panel.grid.minor = element_blank(),
panel.background = element_blank())
# Weight distribution
p2 <- ggplot() +
geom_density(data = original, aes(x = WT, fill = "Original"), alpha = 0.2) +
geom_density(data = bootstrap, aes(x = WT, fill = "Cleaned"), alpha = 0.2) +
scale_fill_manual(values = c("Original" = "blue", "Cleaned" = "red")) +
labs(title = "Weight Distribution Comparison", x = "Weight (kg)", y = "Density") +
theme_bw() +
theme(legend.position = "top",panel.grid.major = element_blank(),
panel.grid.minor = element_blank(),
panel.background = element_blank())
# Height distribution
p3 <- ggplot() +
geom_density(data = original, aes(x = HT, fill = "Original"), alpha = 0.2) +
geom_density(data = bootstrap, aes(x = HT, fill = "Cleaned"), alpha = 0.2) +
scale_fill_manual(values = c("Original" = "blue", "Cleaned" = "red")) +
labs(title = "Height Distribution Comparison", x = "Height (cm)", y = "Density") +
theme_bw() +
theme(legend.position = "top",panel.grid.major = element_blank(),
panel.grid.minor = element_blank(),
panel.background = element_blank())
# Sex distribution
sex_orig <- table(original$SEX)
sex_boot <- table(bootstrap$SEX)
sex_comparison <- data.frame(
SEX = rep(names(sex_orig), 2),
Count = c(as.numeric(sex_orig), as.numeric(sex_boot)),
Proportion = c(sex_orig/sum(sex_orig), sex_boot/sum(sex_boot)),
Type = rep(c("Original", "Cleaned"), each = length(sex_orig))
)
sex_comparison <- sex_comparison %>%
mutate(SEX = factor(SEX, levels = c(0,1), labels = c("Male", "Female")))
p4 <- ggplot(sex_comparison, aes(x = SEX, y = Proportion, fill = Type)) +
geom_bar(stat = "identity", position = "dodge", alpha = 0.7) +
scale_fill_manual(values = c("Original" = "blue", "Cleaned" = "red")) +
labs(title = "Sex Distribution Comparison", x = "Gender", y = "Proportion") +
theme_bw() +
theme(legend.position = "top",
panel.background = element_blank(),
panel.grid.major = element_blank(),
panel.grid.minor = element_blank())
return(list(age = p1, weight = p2, height = p3, sex = p4))
}
